<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>カスタムチケットバッジ</title>
  <style>
    /* バッジ全体のスタイル定義 */
    .ticket-badge {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      
      /* サイズ設定（必要に応じて変更してください） */
      width: 160px;
      height: 120px;
      
      /* 背景色（画像に近いマスタードイエロー） */
      background-color: #cb9b33;
      
      /* 角丸 */
      border-radius: 12px;
      
      /* 文字スタイル */
      color: #ffffff;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-weight: 800; /* 太字 */
      font-size: 48px;  /* 文字の大きさ */
      letter-spacing: 1px;
      
      /* テキスト選択を防止（アプリ風の見た目にするため） */
      user-select: none;
    }
  </style>
</head>
<body>

  <!-- 以下の「S-4」の部分を好きな番号や文字に変更できます -->
  <div class="ticket-badge">S-4</div>

</body>
</html>
